# Copiar a .env y completar. NUNCA commitear .env (los IDs reales están en el brief privado).

# Cuenta de servicio de solo lectura (spreadsheets.readonly + drive.readonly)
# En Docker se monta desde ./secrets/google-sa.json. En local, ruta al JSON:
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=./secrets/google-sa.json
SHEET_ID_PRINCIPAL=
SHEET_ID_MALDONADO=
SHEET_ID_BODEGA=
DRIVE_FOLDER_FOTOS=

WHATSAPP_NUMBER=
MAYOR_DESCUENTO=0.40
MAYOR_UMBRAL=200
SYNC_INTERVAL_MINUTES=60

# Columna "Stock actual" de los locales: 1 = J (confirmado por el cliente), 2 = M
STOCK_COLUMN_OCCURRENCE=1

MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=
ADMIN_TOKEN=
POSTGRES_PASSWORD=
# Fuera de Docker (dotnet run). Dentro de Docker lo arma docker-compose.yml.
DATABASE_URL=postgres://districauchos:CAMBIAR@localhost:5433/districauchos

# Opcional: leer CSV exportados de las hojas en vez de Google ({pestaña}.csv)
# LOCAL_CSV_DIR=./samples
