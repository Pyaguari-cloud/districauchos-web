# Copiar a .env y completar. NUNCA commitear .env (los IDs reales están en el brief privado).

# Cuenta de servicio de solo lectura (spreadsheets.readonly + drive.readonly)
# En Docker se monta desde ./secrets/google-sa.json. En local, ruta al JSON:
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=./secrets/google-sa.json
SHEET_ID_PRINCIPAL=
SHEET_ID_MALDONADO=
SHEET_ID_BODEGA=
# Carpeta de fotos de productos (ID del enlace .../folders/ID), compartida como lector con la cuenta de servicio
DRIVE_FOLDER_FOTOS=
# DRIVE_PHOTOS_INTERVAL_MINUTES=5

WHATSAPP_NUMBER=
MAYOR_DESCUENTO=0.40
MAYOR_UMBRAL=200
SYNC_INTERVAL_MINUTES=60

# Columna "Stock actual" de los locales: 1 = J (confirmado por el cliente), 2 = M
STOCK_COLUMN_OCCURRENCE=1

MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=
ADMIN_TOKEN=
POSTGRES_PASSWORD=
# Fuera de Docker (dotnet run). Dentro de Docker lo arma docker-compose.yml.
DATABASE_URL=postgres://districauchos:CAMBIAR@localhost:5433/districauchos

# Opcional: leer CSV exportados de las hojas en vez de Google ({pestaña}.csv)
# LOCAL_CSV_DIR=./samples

# ---- Pagos en línea con PayPhone (Botón de Pagos) ----
# off = solo cotización por WhatsApp · payphone = cobro real · fake = simulador (solo con SITE_URL en localhost)
PAYMENTS_MODE=off
# De developer.payphone.app (cuenta Business del cliente). Los pone el cliente o el admin directamente aquí.
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=
# Dirección pública de la web. PayPhone devuelve al cliente a SITE_URL/pago/respuesta
SITE_URL=https://districauchosvch.com
IVA_RATE=0.15
# Días de entrega de lo que no hay en stock (0 = no se puede pagar lo que no hay)
BACKORDER_DAYS=4

# ---- Aviso de pedidos pagados por correo ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ORDERS_EMAIL_TO=districauchosich@hotmail.com
