# Caddy: recibe las visitas en 80/443, saca y renueva solo el certificado HTTPS y las pasa a la web.
# SITE_ADDRESS (en .env del servidor):
#   ":80"                                         → pruebas por IP, sin HTTPS (antes de cambiar el dominio)
#   "districauchosvch.com, www.districauchosvch.com" → producción con HTTPS automático
{
	admin off
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	# www → dominio principal (una sola dirección para Google)
	@www host www.districauchosvch.com
	redir @www https://districauchosvch.com{uri} permanent

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	# Fotos de productos. Primero las de la carpeta de Drive del cliente (las baja el worker a /srv/drive/fotos),
	# si no, las subidas con ./deploy.sh --fotos (media/productos). El worker usa el mismo orden al asignarlas.
	# La URL lleva ?v=fecha del archivo, así que se pueden guardar en caché mucho tiempo.
	handle_path /fotos/* {
		root * /srv
		try_files /drive/fotos{path} /fotos{path}
		header Cache-Control "public, max-age=2592000"
		file_server
	}

	reverse_proxy web:3000
}
